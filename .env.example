# Local frontend — copy to .env (gitignored)
# Production: set the same VITE_* names in AWS Amplify → Environment variables

VITE_SUPABASE_URL=https://rvuchforbheotenhkxnm.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_DEMO_MODE=false
VITE_APP_URL=https://talentmanagerx.com
VITE_CDN_URL=https://dxxxx.cloudfront.net
VITE_S3_REGION=us-east-1

# Edge Functions (auto-resolved from VITE_SUPABASE_URL):
#   /functions/v1/ringcentral-oauth
#   /functions/v1/ringcentral-call
#   /functions/v1/ringcentral-sms
#   /functions/v1/ringcentral-webhook
#
# RingCentral API keys → Supabase Edge Function secrets only (.env.secrets.example)
# Auth emails (signup, reset, magic links) are sent by Supabase Auth.

# Vendor connection flags — leave unset until the matching Edge Function secrets
# pass a smoke test. The UI shows Coming soon and keeps send/execute disabled.
